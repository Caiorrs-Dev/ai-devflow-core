{
	"node": {
		"version": "22",
		"cacheManager": "npm"
	},
	"commands": {
		"install": "npm ci",
		"installNoScripts": "npm ci --ignore-scripts",
		"lintFix": "npm run lint:fix",
		"format": "npm run format",
		"e2e": "none.",
		"a11y": "none.",
		"perfBudget": "none.",
		"lint": "npm run lint -- --diagnostic-level=error",
		"typecheck": "npx tsc --noEmit",
		"test": "npm test",
		"testFiles": "npm test -- <paths>",
		"build": "npx tsc --noEmit",
		"deadCode": "npm run knip",
		"mutation": "none.",
		"securityScan": "none.",
		"audit": "npm audit --audit-level=high",
		"extraChecks": "none."
	},
	"lint": {
		"includes": ["src/**", "test/**", "tests/**", "scripts/**", "*.config.*"]
	},
	"knip": {
		"entry": ["src/main.ts", "src/main.tsx", "src/index.ts"]
	},
	"biome": {
		"version": "2.5.15"
	}
}
