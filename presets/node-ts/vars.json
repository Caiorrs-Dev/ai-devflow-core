{
	"commands": {
		"typecheck": "npx tsc -b",
		"build": "npm run build",
		"test": "npx vitest run --reporter=dot",
		"testFiles": "npx vitest run --reporter=dot <paths>",
		"testCoverage": "npx vitest run --coverage --reporter=dot",
		"testChanged": "npx vitest run --changed HEAD^1 --passWithNoTests --reporter=dot"
	},
	"ci": {
		"unitPaths": "- 'src/**'\n- 'test/**'\n- 'tests/**'\n- 'scripts/**'\n- 'package*.json'\n- 'tsconfig*.json'\n- 'vite.config.*'\n- 'vitest.*'"
	}
}
