{
	"name": "ai-devflow-core",
	"version": "0.5.1",
	"private": true,
	"description": "Shared AI development cycle (role briefs, ship-issue orchestrator, plan/ADR templates, gitflow and release workflows) synced into project repositories.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Caiorrs-Dev/ai-devflow-core.git"
	},
	"homepage": "https://github.com/Caiorrs-Dev/ai-devflow-core#readme",
	"bugs": "https://github.com/Caiorrs-Dev/ai-devflow-core/issues",
	"type": "module",
	"bin": {
		"ai-flow": "bin/ai-flow.mjs"
	},
	"files": [
		"bin",
		"lib",
		"core",
		"presets",
		"schema"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "node --test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc -p tsconfig.json",
		"render": "node scripts/render-presets.mjs rendered"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^22.20.5",
		"typescript": "^7.0.2"
	}
}
